# ==============================================================================
# TrustBridge Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Authentication & JWT Configuration
# Required in production: generate a 32+ character high-entropy key
JWT_SECRET=trustbridge-dev-jwt-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Default: SQLite with WAL mode for zero-setup local development
DATABASE_URL=sqlite:///./trustbridge.db

# PostgreSQL Configuration Examples:
# Local PostgreSQL:
# DATABASE_URL=postgresql://trustbridge:password@localhost:5432/trustbridge
# Docker Compose:
# DATABASE_URL=postgresql://trustbridge:trustbridge_secret@db:5432/trustbridge
# Render / Railway / Supabase:
# DATABASE_URL=postgresql://user:password@host.railway.app:5432/trustbridge?sslmode=require

# Notifications & Email Configuration
# Default driver: 'console' (logs outbound emails to console/app logger)
# To enable cloud email delivery in production, see docs/DEPLOYMENT.md for SendGrid/SES setup:
EMAIL_DRIVER=console
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=no-reply@trustbridge.network
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# PayPal REST API Sandbox Credentials
# Obtain at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Sandbox endpoints: https://api-m.sandbox.paypal.com
# Live endpoints:    https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# GitHub Webhooks (Core Verification Engine)
# Secret configured in GitHub repository Settings -> Webhooks
GITHUB_WEBHOOK_SECRET=trustbridge_github_webhook_secret_dev

# AI Contract Builder & Autonomous Negotiator (Local Ollama)
# If Ollama is unavailable, TrustBridge automatically uses the built-in
# deterministic rule-based contract generator and fallback negotiator. No API keys required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15.0

# FX Service Configuration
# Free public FX rate endpoints with fallback caching
FX_RATES_API_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_SECONDS=3600
